<!-- Windows Wazuh Agent(board-host)의 ossec.conf, <ossec_config> 안에 추가.
     파일 위치: C:\Program Files (x86)\ossec-agent\ossec.conf
     fast.log는 자동 차단용(srcip 추출), eve.json은 상세 이벤트 참고용 -->
<localfile>
  <log_format>syslog</log_format>
  <location>C:\suricata-logs\fast.log</location>
</localfile>
<localfile>
  <log_format>json</log_format>
  <location>C:\suricata-logs\eve.json</location>
</localfile>
