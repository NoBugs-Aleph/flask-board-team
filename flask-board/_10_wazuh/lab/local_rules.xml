<!-- Local rules -->

<!-- 기존 예제 룰(원본 유지) -->
<group name="local,syslog,sshd,">
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>
</group>

<!-- ① 게시판 로그인 실패 / 브루트포스 -->
<group name="webapp,local,">
  <rule id="100210" level="5">
    <decoded_as>webapp-login</decoded_as>
    <match>login_failed</match>
    <description>연습 웹앱 로그인 실패</description>
    <group>authentication_failed,</group>
  </rule>

  <!-- 같은 IP 가 120초 안에 실패를 반복하면 브루트포스 의심 -->
  <rule id="100211" level="10" frequency="6" timeframe="120">
    <if_matched_sid>100210</if_matched_sid>
    <same_source_ip />
    <description>연습 웹앱 브루트포스 의심 (동일 IP 다수 실패)</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failures,</group>
  </rule>
</group>

<!-- ② templates 폴더 파일 감시(FIM): 웹셸 생성 / 변조 / 삭제
     (폴더(templates)와 확장자는 match 로 거르고, 생성/삭제 구분은 부모 룰(554/553)이 한다) -->
<group name="syscheck,webshell,local,">
  <!-- 보조 룰(알림 없음): templates 폴더 안의 생성(554)/삭제(553) 이벤트만 통과 -->
  <rule id="100218" level="0">
    <if_sid>553</if_sid>
    <match>templates</match>
    <description>templates 폴더 파일 삭제(보조)</description>
  </rule>
  <rule id="100219" level="0">
    <if_sid>554</if_sid>
    <match>templates</match>
    <description>templates 폴더 파일 생성(보조)</description>
  </rule>

  <rule id="100220" level="12">
    <if_sid>100219</if_sid>
    <match>.php|.phtml|.php5|.jsp|.asp|.aspx|.cgi|.sh|.exe</match>
    <description>게시판 웹 디렉터리에 실행형 파일 생성/변조 - 웹셸 의심</description>
    <mitre><id>T1505.003</id></mitre>
  </rule>

  <!-- 550 = 파일 변경 -->
  <rule id="100221" level="8">
    <if_sid>550</if_sid>
    <match>templates</match>
    <description>게시판 웹 파일 무단 변조 의심</description>
    <mitre><id>T1565.001</id></mitre>
  </rule>

  <rule id="100222" level="10">
    <if_sid>100218</if_sid>
    <match>.php|.phtml|.php5|.jsp|.asp|.aspx|.cgi|.sh|.exe</match>
    <description>게시판 웹 디렉터리의 실행형 파일 삭제 - 흔적 제거 의심(확인 필요)</description>
    <mitre><id>T1070.004</id></mitre>
  </rule>

  <!-- 일반 파일(.html 등) 생성/삭제: 위 실행형 룰에 안 걸린 나머지. 같은 부모 안에서는
       파일 순서대로 먼저 맞는 룰이 이기므로 반드시 100220/100222 뒤에 둔다. -->
  <rule id="100223" level="7">
    <if_sid>100219</if_sid>
    <description>게시판 templates 폴더에 새 파일 생성</description>
    <mitre><id>T1565.001</id></mitre>
  </rule>

  <rule id="100224" level="7">
    <if_sid>100218</if_sid>
    <description>게시판 templates 폴더의 파일 삭제</description>
    <mitre><id>T1070.004</id></mitre>
  </rule>
</group>

<!-- ③ 웹 디렉터리 스캐닝(FIM 아님, 액세스 로그 기반): gobuster·dirbuster 등 -->
<group name="webapp,web,local,">
  <!-- 개별 404 응답(낮은 레벨). level 0 이면 frequency 집계에 안 잡히므로 3 으로 둔다.
       로그인 실패(100210 L5)+브루트포스(100211) 와 같은 2단 구조. 개별 404 자체가
       '연속된 경로 탐색 요청' 증적이 된다. -->
  <rule id="100230" level="3">
    <decoded_as>webapp-access</decoded_as>
    <id>^404$</id>
    <description>연습 웹앱 404 응답 (존재하지 않는 경로 탐색)</description>
  </rule>

  <!-- 같은 IP 가 30초 안에 404 를 10회 이상 유발하면 디렉터리 스캐닝으로 본다 -->
  <rule id="100231" level="10" frequency="10" timeframe="30">
    <if_matched_sid>100230</if_matched_sid>
    <same_source_ip />
    <description>연습 웹앱 디렉터리 스캐닝 의심 (동일 IP 단시간 404 다수 - gobuster/dirb)</description>
    <mitre><id>T1595.003</id></mitre>
    <group>recon,web_scan,</group>
  </rule>
</group>
